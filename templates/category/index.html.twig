{% extends 'base.html.twig' %}

{% block title %}Toutes les catégories{% endblock %}

{% block body %}
    <h1>Toutes les catégories</h1>
    {% for category in categorys %}
    <a href="{{ path('category_show', { categoryName: category.name }) }}">{{ category.name }}</a>
    {% endfor %}
{% endblock %}
