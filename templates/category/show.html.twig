{% extends 'base.html.twig' %}

{% block title %}Catégorie {{ category.name }}{% endblock %}

{% block body %}
    <h1>Séries de la catégorie {{ category.name }}</h1>
    {% for program in programs %}
        <div class="mb-4">
            <h2>{{ program.id }} / <a href="{{ path('program_show', { id: program.id}) }}">{{ program.title }}</a></h2>
            <p>{{ program.summary }}</p>
        </div>
    {% else %}
        <p>Aucune série trouvée</p>
    {% endfor %}
{% endblock %}
