{% extends 'base.html.twig' %}

{% block title %}Donkey Series{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ website }} index</h1>

        {% for program in programs %}
            <div class="mb-4">
                <h2>{{ loop.index }} / {{ program.title }} - Catégorie : {{ program.category.name }}</h2>
                <p>{{ program.summary }}</p>
                {# Lien vers la fiche de la série : #}
                <a href="{{ path('program_show', { id: program.id }) }}">Voir la fiche</a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
