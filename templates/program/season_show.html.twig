{% extends 'base.html.twig' %}

{% block title %}{{ program.title }} {{ season.name }} {{season.year}}{% endblock %}

{% block body %}
    <h1>{{ program.title }}</h1>
    <h2>{{ season.name }}, {{ season.year }}</h2>
    {% for episode in season.episodes %}
    <p>{{ episode.number }}, <a href="{{ path('program_episode_show', { programId: program.id, seasonId: season.id, episodeId: episode.id }) }}">{{ episode.name }}</a></p>
    {% else %}
    <p>Aucun épisode disponible</p>
    {% endfor %}
{% endblock %}
