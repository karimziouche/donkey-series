{% extends 'base.html.twig' %}

{% block title %}Série #{{ program.id }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex">
            <img class="flex-shrink-0 me-3" src="{{ program.poster }}" alt="{{ program.title }} poster" style="width: 200px;">
            <div class="flex-grow-1">
                <h1 class="mt-0">{{ program.title }}</h1>
                <p>{{ program.summary }}</p>
                <p>Catégorie : {{ program.category.name }}</p>
            </div>
        </div>

        <div><h2>Saisons</h2>
        {% for season in seasons %}
        <p><a href="{{ path('program_season_show', { programId: program.id, seasonId: season.id}) }}">{{ season.name }}, année : {{ season.year }}</a></p>
        {% else %}
        <p>Aucune saison disponible</p>
        {% endfor %}
        </div>

        <strong>Acteurs :</strong>
        <ul>
            {% for actor in program.actors %}
                                <li><a href="{{ path('actor_show', { id: actor.id }) }}">{{ actor.name }}</a></li>
            {% else %}
                <li>Aucun acteur pour cette série</li>
            {% endfor %}
        </ul>

        <a href="{{ path('program_index') }}">
            Retour à la liste des programmes
        </a>
    </div>
{% endblock %}
