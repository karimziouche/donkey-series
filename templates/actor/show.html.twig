{% extends 'base.html.twig' %}

{% block title %}Acteur{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ actor.name }}</h1>
        <ul>
        {% for program in actor.programs %}
        <li><a href="{{ path('program_show', { id: program.id}) }}">{{ program.title }}</a></li>
        {% else %}
        <li>Aucun série pour cette acteur</li>
        {% endfor %}
        </ul>
    </div>
{% endblock %}
